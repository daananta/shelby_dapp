{
  "name": "shelby-rag-explorer",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc && tsc -p tsconfig.api.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:rag": "vitest run frontend/evals/ragQualityBenchmark.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run test && npm run build && npm run test:e2e",
    "deploy": "vercel",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "_fmt": "prettier 'frontend/**/*.ts'",
    "fmt": "npm run _fmt -- --write"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^5.0.0",
