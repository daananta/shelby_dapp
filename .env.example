# Public browser configuration. ShelbyNet is the only active public network in
# this release. Testnet values are retained for a future reopening but are not
# contacted by the application while its capability is disabled.
VITE_DEFAULT_SHELBY_NETWORK=shelbynet
# Frontend-safe Geomi client keys only (prefix AG-). Never use an aptoslabs_
# server key here, and never reuse a Testnet key for ShelbyNet automatically.
VITE_SHELBYNET_CLIENT_API_KEY=
VITE_TESTNET_CLIENT_API_KEY=
VITE_SHELBYNET_BLOB_API_URL=https://shelby.shelbynet.shelby.xyz/shelby/v1/blobs
VITE_TESTNET_BLOB_API_URL=https://api.testnet.shelby.xyz/shelby/v1/blobs
VITE_SHELBYNET_ACCESS_CONTROL_MODULE_ADDRESS=
VITE_TESTNET_ACCESS_CONTROL_MODULE_ADDRESS=
# One-release Testnet compatibility fallback:
VITE_SHELBY_CLIENT_API_KEY=
VITE_SHELBY_BLOB_API_URL=
VITE_ACCESS_CONTROL_MODULE_ADDRESS=
VITE_RAG_ACCESS_BROKER_URL=

# Optional hosted embedding gateway. On Vercel this points to the function in api/rag/v1.
VITE_RAG_PIPELINE_API_URL=/api/rag

# Server-only. Never prefix this secret with VITE_.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
APP_ORIGIN=http://localhost:5173
RAG_GATEWAY_ALLOW_SERVER_CALLS=false
