    "react-router-dom": "^6.23.1",
    "remark-gfm": "^4.0.1",
    "stream-browserify": "^3.0.0",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "util": "^0.12.5"
